# AI Transcription API Keys
# Copy this file to .env and fill in your keys.
# See docs/SETUP-API-KEYS.md for detailed instructions.

# Google Gemini API (for PDF handwriting transcription, rename proposals, date detection)
GEMINI_API_KEY=

# OpenAI API (alternative to Gemini for PDF transcription and formatting)
OPENAI_API_KEY=

# AssemblyAI API (for audio transcription with speaker diarization)
ASSEMBLYAI_API_KEY=

# Anthropic API (for transcript formatting with Claude)
ANTHROPIC_API_KEY=
