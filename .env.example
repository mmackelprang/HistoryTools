# AI Transcription API Keys
# Copy this file to .env and fill in your keys.
# See SETUP-API-KEYS.md for detailed instructions.

# Google Gemini API (for PDF handwriting transcription)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# AssemblyAI API (for audio transcription with speaker diarization)
# Get your key at: https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=
